{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/schoolwork/run.ts": {
      "maxDuration": 60
    },
    "api/schedules/schoolwork-sync.ts": {
      "experimentalTriggers": [{ "type": "schedule/v1beta" }],
      "maxDuration": 60
    },
    "api/schedules/push-sweep.ts": {
      "experimentalTriggers": [{ "type": "schedule/v1beta" }],
      "maxDuration": 30
    },
    "api/queues/push-alert.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "push-alerts" }],
      "maxDuration": 30
    }
  },
  "schedules": {
    "schoolwork-hourly-sync": {
      "schedule": "0 * * * *",
      "timezone": "America/New_York",
      "function": "api/schedules/schoolwork-sync"
    },
    "push-alert-sweep": {
      "schedule": "*/15 * * * *",
      "timezone": "America/New_York",
      "function": "api/schedules/push-sweep"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|sw\\.js|manifest\\.webmanifest|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|badge-72\\.png|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
